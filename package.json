{
  "name": "tabulect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sidecar": "node sidecar/server.mjs",
    "dev:web": "node sidecar/server.mjs & vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8760 --strictPort",
    "test": "node --experimental-strip-types --test sidecar/tests/*.test.mjs",
    "smoke": "node sidecar/tests/smoke.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "sync:sidecars": "bash scripts/sync-sidecars.sh",
    "macos:build": "bash scripts/build-macos-arm64.sh",
    "macos:install": "bash scripts/install-macos.sh",
    "check:credentials": "node scripts/check-no-credentials.mjs --source ."
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
